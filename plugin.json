{
    "id": "dmsProfiles",
    "name": "Profiles",
    "description": "Save the whole look of the shell as profiles and switch between them",
    "version": "2.0.0",
    "author": "satoshoe",
    "type": "composite",
    "capabilities": [
        "daemon",
        "dash-tab"
    ],
    "components": {
        "daemon": "./ProfilesDaemon.qml",
        "dash": "./ProfilesDashTab.qml"
    },
    "dash": {
        "title": "Profiles",
        "icon": "palette"
    },
    "settings": "./ProfilesSettings.qml",
    "icon": "palette",
    "requires_dms": ">=1.6.1",
    "permissions": [
        "settings_read",
        "settings_write",
        "process"
    ]
}
